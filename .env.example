# -------------------------------------------------------------------------
# Gemini TTS — German audio generation
# -------------------------------------------------------------------------
# Run once (or whenever new content is added):
#   npx tsx scripts/collect-tts-strings.ts   # collect German strings
#   python3 scripts/generate-tts-gemini.py   # generate Gemini audio
#   python3 scripts/generate-tts-edge.py     # generate Edge audio (optional)
# -------------------------------------------------------------------------

# Required: your Google AI Studio API key.
# Create one at https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Optional: Gemini TTS model.
# The script tries this first and falls back to gemini-2.5-flash-preview-tts
# automatically if this model is unavailable.
TTS_MODEL=gemini-3.1-flash-tts-preview

# Optional: BCP-47 language code for pronunciation. Keep de-DE for German.
TTS_LANGUAGE=de-DE

# Optional: prebuilt Gemini voice name (case-insensitive).
# Each voice name becomes the public/<voice>/ directory and manifest ID.
# Changing this generates a new set of files without removing the old ones.
#
# Available voices:
#   Aoede   — Breezy, natural female
#   Charon  — Informative, clear male
#   Fenrir  — Excitable male
#   Kore    — Firm, clear female (default, good for educational content)
#   Leda    — Youthful female
#   Orus    — Firm male
#   Puck    — Upbeat male
#   Zephyr  — Bright female
TTS_VOICE=Kore

# Optional: max concurrent Gemini API requests.
# The free tier allows ~10 RPM for TTS preview models; 3 is safe.
# Paid tiers support much higher concurrency — raise this for faster generation.
GEMINI_CONCURRENCY=3

# -------------------------------------------------------------------------
# GitHub Pages deployment (set by CI — do not set for local development)
# -------------------------------------------------------------------------
# NEXT_PUBLIC_BASE_PATH=/Lern-Deutsch
